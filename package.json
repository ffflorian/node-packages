{
  "author": "Florian Imdahl <git@ffflorian.de>",
  "description": "My Node.js packages",
  "devDependencies": {
    "@ffflorian/oxfmt-config": "1.2.0",
    "@ffflorian/oxlint-config": "1.0.8",
    "@nx/js": "23.2.1",
    "@types/node": "~26",
    "eslint": "10.10.0",
    "eslint-plugin-perfectionist": "5.11.0",
    "lefthook": "2.1.12",
    "nx": "23.2.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">= 18.0"
  },
  "license": "GPL-3.0",
  "name": "node-packages",
  "packageManager": "yarn@4.18.0",
  "private": true,
  "scripts": {
    "build:ts": "yarn workspaces foreach --all --parallel --topological --exclude node-packages run build",
    "clean": "yarn workspaces foreach --all --parallel --exclude node-packages run clean",
    "dist": "yarn clean && yarn build:ts",
    "fix": "yarn fix:ts && yarn fix:other",
    "fix:other": "yarn format --write",
    "fix:ts": "yarn lint:ts --fix",
    "format": "oxfmt .",
    "lint": "yarn lint:other && yarn lint:ts",
    "lint:other": "yarn format --list-different",
    "lint:ts": "oxlint --ignore-path .gitignore packages/",
    "release": "nx release --yes",
    "test": "yarn test:all",
    "test:all": "yarn workspaces foreach --all --parallel --exclude node-packages run test"
  },
  "workspaces": [
    "packages/*"
  ]
}
